# Supabase local development endpoints.
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=supabase_anon_key_here

# Google OAuth credentials (get from Google Cloud Console).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=google_client_id_here.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=google_client_secret_here

# Facebook OAuth credentials (get from Meta for Developers).
SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=facebook_client_id_here
SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=facebook_client_secret_here
